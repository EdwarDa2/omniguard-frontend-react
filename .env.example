# ============================================================
# OmniGuard Frontend (React + Vite) - Variables de Entorno (Plantilla)
# ============================================================

# URL base relativa de la API (utiliza el proxy de Vite en desarrollo para evitar bloqueo de cookies HttpOnly)
VITE_API_BASE_URL=/api/v1

# Destino del servidor Backend Spring Boot para el proxy local
VITE_BACKEND_URL=http://localhost:8080

# Intervalo de polling auxiliar (en milisegundos)
VITE_POLLING_INTERVAL_MS=15000

# Título de la aplicación
VITE_APP_TITLE=OmniGuard SOC Platform
